# =============================================================
# ConvertAnyFile — Environment Variables
# =============================================================
# Copy this file to .env.local (which is gitignored) and fill in
# your real values. Variables MUST start with VITE_ to be exposed
# to client-side code.
# =============================================================

# Google AdSense Publisher ID
# Format: ca-pub-XXXXXXXXXXXXXXXX (16 digits after ca-pub-)
# Get this from https://www.google.com/adsense once approved.
# Leave EMPTY in dev/staging to disable ads entirely.
VITE_ADSENSE_CLIENT=

# AdSense Ad Slot IDs
# Format: numeric string, e.g. 1234567890
# Create ad units in AdSense dashboard and paste the slot ID here.
VITE_ADSENSE_SLOT_HEADER=

# =============================================================
# Notes:
# - Ads are ONLY loaded in production builds (import.meta.env.PROD)
# - Ads are ONLY loaded AFTER user accepts the cookie consent banner
# - In dev mode, you'll see a placeholder showing where ads will appear
# =============================================================
